// Requires app instrumentation to emit these body-free attributes.
AppTraces
| where TimeGenerated > ago(1h)
| extend agent=tostring(Properties["agent.role"]), tenant=tostring(Properties["tenant_scope"])
| extend input_tokens=tolong(Properties["gen_ai.usage.input_tokens"]), output_tokens=tolong(Properties["gen_ai.usage.output_tokens"])
| summarize requests=count(), input_tokens=sum(input_tokens), output_tokens=sum(output_tokens) by agent, tenant
// Missing attributes mean unknown allocation, not zero cost. Join approved price
// revision separately and reconcile total billed service usage/reservations.
