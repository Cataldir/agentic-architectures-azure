<policies>
  <inbound>
    <base />
    <validate-jwt header-name="Authorization" require-scheme="Bearer" output-token-variable-name="caller" failed-validation-httpcode="401">
      <openid-config url="https://login.microsoftonline.com/{{course-tenant-id}}/v2.0/.well-known/openid-configuration" />
      <audiences><audience>{{course-api-audience}}</audience></audiences>
      <required-claims><claim name="roles" match="any"><value>Orders.Read</value></claim></required-claims>
    </validate-jwt>
    <choose>
      <when condition='@(((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("tid", "") != "{{course-tenant-id}}" || string.IsNullOrEmpty(((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("oid", "")))'>
        <return-response><set-status code="401" reason="Missing authenticated actor or tenant" /></return-response>
      </when>
    </choose>
    <set-variable name="actorKey" value='@(((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("tid", "") + ":" + ((Jwt)context.Variables["caller"]).Claims.GetValueOrDefault("oid", ""))' />
    <rate-limit-by-key calls="10" renewal-period="60" counter-key='@((string)context.Variables["actorKey"])' />
    <set-header name="X-Course-Actor" exists-action="override"><value>@((string)context.Variables["actorKey"])</value></set-header>
    <!-- No semantic/token model policy on arbitrary MCP JSON-RPC bodies. -->
  </inbound>
  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
